{
  "schemaVersion": 2,
  "name": "DropRadar",
  "projectSlug": "dropradar",
  "sourceVersion": "V2",
  "capabilities": {
    "auth": false,
    "push": false,
    "realtime": false,
    "askAi": {
      "enabled": false,
      "allowedModels": [],
      "allowStreaming": true,
      "allowImages": true
    },
    "localMachineAgentServices": [],
    "outboundHttp": {
      "allowedHosts": [
        "discord.com",
        "api.pokemontcgapi.com"
      ]
    }
  },
  "requiredSecrets": [
    "DISCORD_PUBLIC_KEY",
    "DISCORD_BOT_TOKEN",
    "POKEMONTCG_API_KEY"
  ],
  "environment": [],
  "dataCollections": [
    {
      "name": "authorized_source_imports",
      "indexes": [
        {
          "name": "by-source",
          "field": "source",
          "sortField": "observedAt"
        }
      ]
    },
    {
      "name": "observations",
      "indexes": [
        {
          "name": "by-product",
          "field": "productId",
          "sortField": "observedAt"
        }
      ]
    },
    {
      "name": "current_observations",
      "indexes": [
        {
          "name": "by-product",
          "field": "productId"
        }
      ]
    },
    {
      "name": "watches",
      "indexes": [
        {
          "name": "by-product",
          "field": "productId",
          "sortField": "createdAt"
        },
        {
          "name": "by-user",
          "field": "userId",
          "sortField": "createdAt"
        }
      ]
    },
    {
      "name": "alert_events",
      "indexes": [
        {
          "name": "by-product",
          "field": "productId",
          "sortField": "createdAt"
        }
      ]
    },
    {
      "name": "alert_deliveries",
      "indexes": [
        {
          "name": "by-status-updated",
          "field": "status",
          "sortField": "updatedAt"
        },
        {
          "name": "by-status-lease",
          "field": "status",
          "sortField": "leaseUntil"
        },
        {
          "name": "by-alert",
          "field": "alertId"
        },
        {
          "name": "by-user",
          "field": "userId",
          "sortField": "updatedAt"
        }
      ]
    },
    {
      "name": "source_health",
      "indexes": []
    },
    {
      "name": "audit_events",
      "indexes": [
        {
          "name": "by-source",
          "field": "source",
          "sortField": "at"
        }
      ]
    },
    {
      "name": "source_mappings",
      "indexes": []
    },
    {
      "name": "retailer_links",
      "indexes": []
    }
  ],
  "runtimeWritablePaths": [],
  "routes": [
    {
      "method": "GET",
      "path": "/api/health",
      "kind": "Function",
      "target": "health"
    },
    {
      "method": "GET",
      "path": "/api/products",
      "kind": "Function",
      "target": "products"
    },
    {
      "method": "GET",
      "path": "/api/products/:id",
      "kind": "Function",
      "target": "product-detail"
    },
    {
      "method": "POST",
      "path": "/api/discord",
      "kind": "Function",
      "target": "discord-webhook"
    },
    {
      "method": "POST",
      "path": "/api/growth",
      "kind": "Function",
      "target": "growth-tracker",
      "rateLimitPerMinute": 120
    },
    {
      "method": "GET",
      "path": "/go/:retailer/:product",
      "kind": "Function",
      "target": "retailer-redirect",
      "rateLimitPerMinute": 60
    }
  ],
  "files": [
