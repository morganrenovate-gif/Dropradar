      "sourcePath": "hedy/functions/product-detail.js",
      "modules": [
        "dropradar"
      ]
    },
    {
      "name": "discord-webhook",
      "sourcePath": "hedy/functions/discord.js",
      "modules": [
        "dropradar",
        "tweetnacl"
      ]
    },
    {
      "name": "collect-authorized-imports",
      "sourcePath": "hedy/functions/collect.js",
      "modules": [
        "dropradar"
      ]
    },
    {
      "name": "deliver-alerts",
      "sourcePath": "hedy/functions/deliver.js",
      "modules": [
        "dropradar"
      ]
    },
    {
      "name": "collect-pokemontcg",
      "sourcePath": "hedy/functions/collect-pokemontcg.js",
      "modules": [
        "dropradar"
      ]
    },
    {
      "name": "growth-tracker",
      "sourcePath": "hedy/functions/track-growth.js",
      "modules": []
    },
    {
      "name": "retailer-redirect",
      "sourcePath": "hedy/functions/retailer-redirect.js",
      "modules": [
        "dropradar"
      ]
    }
