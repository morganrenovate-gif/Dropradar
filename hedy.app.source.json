  "schedules": [
    {
      "name": "collect-authorized-imports",
      "functionName": "collect-authorized-imports",
      "cronExpression": "*/5 * * * *",
      "timeZone": "UTC",
      "kind": "recurring"
    },
    {
      "name": "deliver-alerts",
      "functionName": "deliver-alerts",
      "cronExpression": "* * * * *",
      "timeZone": "UTC",
      "kind": "recurring"
    },
    {
      "name": "collect-pokemontcg",
      "functionName": "collect-pokemontcg",
      "cronExpression": "17 18 * * *",
      "timeZone": "UTC",
      "kind": "recurring",
      "enabled": false
    }
  ],
  "inboundWebhooks": []
